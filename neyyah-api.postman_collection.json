{
  "info": {
    "name": "Neyyah API v1",
    "_postman_id": "neyyah-api-v1",
    "description": "Complete API collection for Neyyah (نية) matrimonial app.\n\nBase URL: {{base_url}}\nAuth: Bearer token (obtained from verify-otp)\n\nFlow:\n1. POST auth/send-otp  → get code in response (dev mode)\n2. POST auth/verify-otp → token auto-saved to {{token}}\n3. Use any protected endpoint",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",         "value": "http://localhost/neyyah/public/api/v1", "type": "string" },
    { "key": "token",            "value": "", "type": "string" },
    { "key": "user_id",          "value": "", "type": "string" },
    { "key": "target_user_id",   "value": "", "type": "string" },
    { "key": "request_id",       "value": "", "type": "string" },
    { "key": "conversation_id",  "value": "", "type": "string" },
    { "key": "question_id",      "value": "", "type": "string" },
    { "key": "notification_id",  "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [

    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"phone\": \"+962791234567\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/send-otp", "host": ["{{base_url}}"], "path": ["auth","send-otp"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.code) {",
                  "  pm.collectionVariables.set('otp_code', json.data.code);",
                  "  console.log('OTP code:', json.data.code);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify OTP (Login / Register)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"phone\": \"+962791234567\",\n  \"code\": \"{{otp_code}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/verify-otp", "host": ["{{base_url}}"], "path": ["auth","verify-otp"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "  pm.collectionVariables.set('user_id', json.data.user.id);",
                  "  console.log('Token saved. is_new:', json.data.is_new);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/refresh-token", "host": ["{{base_url}}"], "path": ["auth","refresh-token"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth","logout"] }
          }
        }
      ]
    },

    {
      "name": "🏙️ Cities (Public)",
      "item": [
        {
          "name": "Get All Cities",
          "request": {
            "auth": { "type": "noauth" },
